# Copy to .env before first start
POSTGRES_USER=moneyos
POSTGRES_PASSWORD=change-me-local
POSTGRES_DB=moneyos
POSTGRES_PORT=5432

N8N_PORT=5678
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-string

SEARXNG_PORT=8080
CRAWL4AI_PORT=11235
LITELLM_PORT=4000
API_PORT=8000

# Local Ollama runs on macOS, not in Docker.
# Recommended starter model: qwen3:8b
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:8b
LITELLM_MASTER_KEY=sk-local-moneyos

# App behavior
SEARCH_LIMIT=8
CRAWL_LIMIT=5
MAX_PAGE_CHARS=24000
